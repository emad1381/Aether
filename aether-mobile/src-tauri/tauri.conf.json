{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "2.0.0",
  "identifier": "com.aether.mobile",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aether",
        "width": 390,
        "height": 844,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data:;"
    }
  },
  "bundle": {
    "active": false
  }
}
