{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "2.1.5",
  "identifier": "com.aether.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aether",
        "width": 980,
        "height": 720,
        "minWidth": 840,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data:; connect-src ipc: http: https:;"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/icon.png"
    ]
  }
}
