{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "2.0.0",
  "identifier": "com.aether.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aether",
        "width": 980,
        "height": 720,
        "minWidth": 840,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data:; connect-src ipc: http: https:;"
    }
  },
  "bundle": {
    "active": false
  }
}
